# Discord Authentication
# Your Discord User Token (Keep this private!)
DISCORD_TOKEN=your_discord_token_here

# Discord Channel ID to monitor (e.g. #giveaways or #announcements)
TARGET_CHANNEL_ID=123456789012345678

# Target Platform / Lucid Account API Settings
# Multi-account support: Comma-separated list of account authorization tokens/keys
ACCOUNT_TOKENS=account_token_1,account_token_2,account_token_3

# Target Redemption API Endpoint URL
REDEMPTION_API_URL=https://api.lucidtrading.com/v1/giveaways/claim

# Custom headers if required (JSON format or key=value)
CLAIM_ENDPOINT_PATH=/v1/giveaways/claim
